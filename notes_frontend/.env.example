# PUBLIC INTERFACE: Environment variables required to configure the Notes Frontend

# Base URL for the backend Notes API (notes_database) - e.g., http://localhost:4000 or a full https URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# OAuth-like or token-based authentication
# If your backend supports username/password login that returns a JWT, keep this as-is.
# For other auth providers, adjust in src/lib/api.ts accordingly.
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_AUTH_REGISTER_PATH=/auth/register

# Optional - if deploying behind a reverse proxy prefix
NEXT_PUBLIC_API_PREFIX=

# Site URL for redirect / deep links (used by email-based auth flows if implemented)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
